# 字体配置
font-family = FiraCode Nerd Font Mono
font-family = JetBrains Mono
font-family = Hack Nerd Font
font-family = NotoSans Nerd Font
font-family = Fira Code
font-family = Heiti SC
font-family = Apple Color Emoji
font-family = Noto Sans CJK JP
font-family = Noto Sans CJK KR
font-family = Symbols Nerd Font
font-size = 15
font-feature = +liga +calt +ss01

# 窗口配置
window-decoration = true
#macos-titlebar-style = transparent
macos-titlebar-style = tabs
window-padding-balance = true
window-padding-x = 12
window-padding-y = 0
background-opacity = 0.7
background-blur-radius = 10

# 光标配置
cursor-style = block
cursor-style-blink = true
cursor-color = #F091A0
selection-background = #F091A0

# 回滚缓冲
scrollback-limit = 3023

# 终端特性
mouse-hide-while-typing = true
copy-on-select = false
confirm-close-surface = false

# 禁用烦人的“已复制到剪贴板”通知
app-notifications = no-clipboard-copy,no-config-reload

# 常用按键绑定
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
#keybind = ctrl+shift+n=new_window
#keybind = ctrl+t=new_tab
#keybind = ctrl+plus=increase_font_size:1
#keybind = ctrl+minus=decrease_font_size:1
#keybind = ctrl+zero=reset_font_size

# Material 3 UI 元素
unfocused-split-opacity = 0.7
unfocused-split-fill = #44464f

# 标签配置
gtk-titlebar = false

# Shell 集成
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor

# 自定义按键行为
keybind = shift+escape=text:~
keybind = shift+enter=text:\n
keybind = super+ctrl+h=goto_split:left
keybind = super+ctrl+j=goto_split:down
keybind = super+ctrl+k=goto_split:up
keybind = super+ctrl+l=goto_split:right

# 其他配置
gtk-single-instance = true

theme = Monokai Remastered
