export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

export JAVA_HOME="$(/usr/libexec/java_home -v 17)"
export M2_HOME=/opt/homebrew/opt/maven/libexec
export MANPATH=$(brew --prefix coreutils)/libexec/gnuman:$MANPATH
export GRADLE_USER_HOME=/usr/local/gradle/caches
export GOPATH=~/coding/go
export LLM_KEY=NONE
export LOCAL_LLM_KEY=NONE
export EDITOR=vim
#export HOMEBREW_BOTTLE_DOMAIN=https://mirrors.cloud.tencent.com/homebrew-bottles
#export PYTHONPATH=/usr/local/opt/xgboost/python-package:/usr/local/opt/LightGBM/python-package
export NVM_DIR="$HOME/.nvm"

