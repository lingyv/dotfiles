# 打印.gitignore文件 使用 --> pgi java,python
function pgi() { curl -L -s https://www.toptal.com/developers/gitignore/api/$@ ;}

# yazi 文件管理器
function yy() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
	yazi "$@" --cwd-file="$tmp"
	if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
		cd -- "$cwd"
	fi
	rm -f -- "$tmp"
}

# 生成.gitignore文件 使用 --> gi java,python
function gi() {
    if [ ! -f .gitignore ]
    then
        echo "--> 创建 .gitignore 文件"
        touch .gitignore
    fi
    echo "--> 向 .gitignore 中追加内容"
    curl https://www.gitignore.io/api/$@ >> .gitignore;
}

# 查看gitignore.io网站支持的命令
function gilist() { curl -L -s https://www.gitignore.io/api/list ;}

vf() {
    nvim $(fzf)
}

# fd - 进入所选目录
fd() {
  local dir
  dir=$(find ${1:-.} -path '*/\.*' -prune \
                  -o -type d -print 2> /dev/null | fzf +m) &&
  cd "$dir"
}

# fda - 包含隐藏目录
fda() {
  local dir
  dir=$(find ${1:-.} -type d 2> /dev/null | fzf +m) && cd "$dir"
}

# fdr - 进入所选父目录
fdr() {
  local declare dirs=()
  get_parent_dirs() {
    if [[ -d "${1}" ]]; then dirs+=("$1"); else return; fi
    if [[ "${1}" == '/' ]]; then
      for _dir in "${dirs[@]}"; do echo $_dir; done
    else
      get_parent_dirs $(dirname "$1")
    fi
  }
  local DIR=$(get_parent_dirs $(realpath "${1:-$PWD}") | fzf-tmux --tac)
  cd "$DIR"
}

function copySSHKey() {
    cat ~/.ssh/id_rsa.pub | pbcopy
}

# 简易计算器
function calc() {
	local result="";
	result="$(printf "scale=10;$*\n" | bc --mathlib | tr -d '\\\n')";
		#                       └─ 默认值（使用 `--mathlib` 时）是 20
	#
	if [[ "$result" == *.* ]]; then
			# 优化小数输出
		printf "$result" |
			sed -e 's/^\./0./'        `# 处理 ".5" 这类情况，补前导 0` \
			    -e 's/^-\./-0./'      `# 处理 "-.5" 这类情况，补前导 0`\
			    -e 's/0*$//;s/\.$//';  # 去掉末尾无效 0
	else
		printf "$result";
	fi;
	printf "\n";
}

# 创建目录并进入
function mkd() {
	mkdir -p "$@" && cd "$_";
}

# 切换到 Finder 最上层窗口所在目录
function cdf() { # `cdfinder` 的简写
	cd "$(osascript -e 'tell app "Finder" to POSIX path of (insertion location as alias)')";
}

# 创建 .tar.gz 压缩包，压缩器优先级：`zopfli` -> `pigz` -> `gzip`
function targz() {
	local tmpFile="${@%/}.tar";
	tar -cvf "${tmpFile}" --exclude=".DS_Store" "${@}" || return 1;

	size=$(
			stat -f"%z" "${tmpFile}" 2> /dev/null; # macOS `stat`
		stat -c"%s" "${tmpFile}" 2> /dev/null # GNU `stat`
	);

	local cmd="";
	if (( size < 52428800 )) && hash zopfli 2> /dev/null; then
			# .tar 小于 50MB 且安装了 zopfli 时优先使用 zopfli
		cmd="zopfli";
	else
		if hash pigz 2> /dev/null; then
			cmd="pigz";
		else
			cmd="gzip";
		fi;
	fi;

	echo "Compressing .tar using \`${cmd}\`…";
	"${cmd}" -v "${tmpFile}" || return 1;
	[ -f "${tmpFile}" ] && rm "${tmpFile}";
	echo "${tmpFile}.gz created successfully.";
}

# 统计文件大小或目录总大小
function fs() {
	if du -b /dev/null > /dev/null 2>&1; then
		local arg=-sbh;
	else
		local arg=-sh;
	fi
	if [[ -n "$@" ]]; then
		du $arg -- "$@";
	else
		du $arg .[^.]* *;
	fi;
}

# 若可用则使用 Git 的彩色 diff
hash git &>/dev/null;
if [ $? -eq 0 ]; then
	function diff() {
		git diff --no-index --color-words "$@";
	}
fi;

# 从文件生成 data URL
function dataurl() {
	local mimeType=$(file -b --mime-type "$1");
	if [[ $mimeType == text/* ]]; then
		mimeType="${mimeType};charset=utf-8";
	fi
	echo "data:${mimeType};base64,$(openssl base64 -in "$1" | tr -d '\n')";
}


# 对比原始文件与 gzip 后大小
function gz() {
	local origsize=$(wc -c < "$1");
	local gzipsize=$(gzip -c "$1" | wc -c);
	local ratio=$(echo "$gzipsize * 100 / $origsize" | bc -l);
	printf "orig: %d bytes\n" "$origsize";
	printf "gzip: %d bytes (%2.2f%%)\n" "$gzipsize" "$ratio";
}

# 对 JSON 字符串或文件进行语法高亮
# 用法: `json '{"foo":42}'` 或 `echo '{"foo":42}' | json`
function json() {
		if [ -t 0 ]; then # 参数模式
		python -mjson.tool <<< "$*" | pygmentize -l javascript;
		else # 管道模式
		python -mjson.tool | pygmentize -l javascript;
	fi;
}

# 运行 `dig` 并展示关键信息
function digga() {
	dig +nocmd "$1" any +multiline +noall +answer;
}

# 将字符串编码为 UTF-8 十六进制
function escape() {
	printf "\\\x%s" $(printf "$@" | xxd -p -c1 -u);
		# 如果不是管道输出，则补一个换行
	if [ -t 1 ]; then
			echo ""; # 换行
	fi;
}

# 解码 \x{ABCD} 风格的 Unicode 转义
function unidecode() {
	perl -e "binmode(STDOUT, ':utf8'); print \"$@\"";
		# 如果不是管道输出，则补一个换行
	if [ -t 1 ]; then
			echo ""; # 换行
	fi;
}

# 获取字符的 Unicode 码点
function codepoint() {
	perl -e "use utf8; print sprintf('U+%04X', ord(\"$@\"))";
		# 如果不是管道输出，则补一个换行
	if [ -t 1 ]; then
			echo ""; # 换行
	fi;
}

# zoxide 命令说明
# - z <关键字>: 按 zoxide 记录的频率和最近访问跳转目录。
# - zi: zoxide 自带的交互式跳转命令（由 .zshrc 中的 `zoxide init zsh` 提供）。
# - Alt+z: 本文件把 Alt+z 绑定到 `zoxide-zi`（带预览的自定义选择器），不是原始 `zi`。
# - zfp: 预览并选择目录，跳转后执行 `ls -la`。
# - zcode: 预览并选择目录，跳转后使用 `cursor .` 打开。
# - zexec: 预览并选择目录，跳转后输入并执行命令。
# - _zoxide_fzf_pick: 上述自定义函数共用的底层 fzf 目录选择器。
# zoxide + fzf 集成
if command -v zoxide >/dev/null 2>&1; then
  export _ZO_FZF_OPTS="--height 40% --reverse --border --border-label ' zoxide ' --prompt '📁  '"
fi

function _zoxide_fzf_pick() {
  zoxide query -l | fzf \
    --height 40% \
    --reverse \
    --border \
    --border-label ' zoxide ' \
    --prompt '📁  ' \
    --preview 'if command -v tree >/dev/null 2>&1; then tree -C -L 2 {} | head -n 200; else ls -la {}; fi' \
    --preview-window 'right:55%,wrap'
}

function zfp() {
  local dir
  dir=$(_zoxide_fzf_pick)
  [[ -n "$dir" ]] && z "$dir" && ls -la
}

function zcode() {
  local dir
  dir=$(_zoxide_fzf_pick)
  [[ -n "$dir" ]] && z "$dir" && command -v cursor >/dev/null 2>&1 && cursor .
}

function zexec() {
  local dir cmd
  dir=$(_zoxide_fzf_pick)
  if [[ -n "$dir" ]]; then
    z "$dir" || return
    read -r "?Enter command: " cmd
    [[ -n "$cmd" ]] && eval "$cmd"
  fi
}

if [[ -o interactive ]]; then
  function zoxide-zi() {
    local dir
    zle -I
    dir=$(_zoxide_fzf_pick)
    [[ -n "$dir" ]] && z "$dir"
    zle reset-prompt
  }

  zle -N zoxide-zi
  bindkey -M emacs '\ez' zoxide-zi
  bindkey -M vicmd '\ez' zoxide-zi
  bindkey -M viins '\ez' zoxide-zi
fi

# 显示指定域名证书中的所有名称（CN 和 SAN）
function getcertnames() {
	if [ -z "${1}" ]; then
		echo "ERROR: No domain specified.";
		return 1;
	fi;

	local domain="${1}";
	echo "Testing ${domain}…";
	echo ""; # 换行

	local tmp=$(echo -e "GET / HTTP/1.0\nEOT" \
		| openssl s_client -connect "${domain}:443" -servername "${domain}" 2>&1);

	if [[ "${tmp}" = *"-----BEGIN CERTIFICATE-----"* ]]; then
		local certText=$(echo "${tmp}" \
			| openssl x509 -text -certopt "no_aux, no_header, no_issuer, no_pubkey, \
			no_serial, no_sigdump, no_signame, no_validity, no_version");
		echo "Common Name:";
		echo ""; # 换行
		echo "${certText}" | grep "Subject:" | sed -e "s/^.*CN=//" | sed -e "s/\/emailAddress=.*//";
		echo ""; # 换行
		echo "Subject Alternative Name(s):";
		echo ""; # 换行
		echo "${certText}" | grep -A 1 "Subject Alternative Name:" \
			| sed -e "2s/DNS://g" -e "s/ //g" | tr "," "\n" | tail -n +2;
		return 0;
	else
		echo "ERROR: Certificate not found.";
		return 1;
	fi;
}

# `v` 无参数时在 Vim 中打开当前目录；有参数时打开指定路径
function v() {
	if [ $# -eq 0 ]; then
		vim .;
	else
		vim "$@";
	fi;
}

# `o` 无参数时打开当前目录；有参数时打开指定路径
function o() {
	if [ $# -eq 0 ]; then
		open .;
	else
		open "$@";
	fi;
}

# `tre` 是 `tree` 的快捷封装：显示隐藏文件、启用颜色、忽略 `.git`
# 且目录优先排序。输出会进入 `less`（保留颜色与行号），
# 若内容较短则可直接一屏显示。
function tre() {
	tree -aC -I '.git|node_modules|bower_components' --dirsfirst "$@" | less -FRNX;
}
