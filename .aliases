# thefuck (if installed)
if command -v thefuck >/dev/null 2>&1; then
  eval $(thefuck --alias)
  eval $(thefuck --alias FUCK)
fi

# zoxide quick jump
if command -v zoxide >/dev/null 2>&1; then
  alias j='z'
fi

# Proxy settings
alias setproxy="export https_proxy=http://127.0.0.1:1081 http_proxy=http://127.0.0.1:1081 all_proxy=socks5://127.0.0.1:1081"
alias unsetproxy="unset https_proxy http_proxy all_proxy"

# npm mirror
alias cnpm="npm --registry=https://registry.npmmirror.com --cache=$HOME/.npm/.cache/cnpm --disturl=https://npmmirror.com/mirrors/node --userconfig=$HOME/.cnpmrc"

# Editor
alias vi=nvim
alias cat='bat --paging=never' 2>/dev/null || alias cat=cat

# eza as ls replacement
if command -v eza >/dev/null 2>&1; then
  alias ls='eza --icons'
  alias l='eza -alh --icons'
  alias la='eza -la --icons'
  alias ll='eza -l --icons'
  alias lt='eza --tree --icons'
  alias lsd='eza -l --icons --group-directories-first | rg "^d"'
fi

# ripgrep as grep replacement
if command -v rg >/dev/null 2>&1; then
  alias grep='rg'
  alias fgrep='rg -F'
  alias egrep='rg -E'
fi

# Get week number
alias week='date +%V'

# Stopwatch
alias timer='echo "Timer started. Stop with Ctrl-D." && date && time cat && date'

# Update Arch Linux
alias update='sudo pacman -Syu && yay -Syu && yay -Yc'

# IP addresses
alias localip="ip route get 1.1.1.1 | grep -oP 'src \K\S+'"
alias ips="ip addr show"

# Print each PATH entry on a separate line
alias path='echo -e ${PATH//:/\\n}'

# Reload the shell (i.e. invoke as a login shell)
alias reload="exec $SHELL -l"

# Network
alias route="ip route"
alias listport="ss -tlnp"

# Copy SSH key to clipboard (requires xclip on Arch)
if command -v xclip >/dev/null 2>&1; then
  function copySSHKey() {
    cat ~/.ssh/id_rsa.pub | xclip -selection clipboard
  }
fi

# Clean up .DS_Store files (if any from macOS)
alias cleanup="find . -type f -name '*.DS_Store' -ls -delete 2>/dev/null || true"

# Empty trash
alias emptytrash="rm -rf ~/.local/share/Trash/* 2>/dev/null || true"